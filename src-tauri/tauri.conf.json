{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "x1Aoshy POS",
  "version": "1.0.0",
  "identifier": "com.restaurant.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "x1Aoshy POS",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost ; script-src 'self' ; style-src 'self' 'unsafe-inline' ; img-src 'self' data: asset: http://asset.localhost ; font-src 'self' data: ; connect-src 'self' ipc: http://ipc.localhost https: ; object-src 'none' ; frame-ancestors 'none' ; base-uri 'self' ; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true,
        "compression": "lzma"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    }
  }
}
