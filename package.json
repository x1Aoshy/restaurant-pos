{
  "name": "restaurant",
  "private": true,
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:schema": "node --experimental-sqlite scripts/check-schema.mjs",
    "verify": "tsc --noEmit && npm run check:migrations && npm run check:i18n && npm run check:schema && npm run check:sync && npm run check:seed && npm run check:business && npm run check:discount && npm run check:audit && npm run check:kitchen && npm run check:cash",
    "check:sync": "node --experimental-sqlite scripts/check-sync.mjs",
    "check:seed": "node --experimental-sqlite scripts/check-seed.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "lock:migrations": "node scripts/check-migrations.mjs --update",
    "check:business": "node --experimental-sqlite scripts/check-business.mjs",
    "check:discount": "node --experimental-sqlite scripts/check-discount.mjs",
    "check:audit": "node --experimental-sqlite scripts/check-audit.mjs",
    "check:kitchen": "node --experimental-sqlite scripts/check-kitchen.mjs",
    "check:cash": "node --experimental-sqlite scripts/check-cash.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.18.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "^0.28.1",
    "shadcn": "^4.15.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
